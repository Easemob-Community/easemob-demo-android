<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:scrollbars="none"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="50dp"
        android:background="@color/ease_color_background"
        android:orientation="vertical">

        <!-- Profile header, aligned with iOS MeProfileHeader: avatar on the left -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="16dp">

            <com.hyphenate.easeui.widget.ChatUIKitCustomAvatarView
                android:id="@+id/ep_presence"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tv_name"
                style="@style/ease_detail_layout_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@id/ep_presence"
                app:layout_constraintTop_toTopOf="@id/ep_presence"
                app:layout_constraintEnd_toStartOf="@+id/ic_notice" />

            <com.hyphenate.easeui.widget.ChatUIKitImageView
                android:id="@+id/ic_notice"
                android:visibility="gone"
                android:src="@drawable/uikit_do_not_disturb"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintTop_toTopOf="@+id/tv_name"
                app:layout_constraintBottom_toBottomOf="@+id/tv_name"
                app:layout_constraintStart_toEndOf="@+id/tv_name" />

            <TextView
                android:id="@+id/tv_sign"
                style="@style/ease_detail_layout_subtitle2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingVertical="2dp"
                app:layout_constraintStart_toStartOf="@id/tv_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_name"
                tools:text="signature" />

            <TextView
                android:id="@+id/tv_number"
                style="@style/ease_detail_layout_subtitle2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="5dp"
                app:layout_constraintStart_toStartOf="@id/tv_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_sign" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:text="@string/main_about_me_about"
            android:layout_marginTop="20dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="4dp"
            android:textAppearance="@style/Ease.TextAppearance.Label.Medium"
            android:textColor="@color/ease_details_subtitle2_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.hyphenate.easeui.widget.ChatUIKitArrowItemView
            android:id="@+id/item_business"
            app:arrowItemTitle="@string/about_business_cooperation"
            app:arrowItemContent="@string/main_about_me_business_phone"
            app:arrowItemShowAvatar="false"
            app:arrowItemShowArrow="false"
            style="@style/main_about_me_arrow_item"
            android:layout_width="match_parent"
            android:layout_height="54dp" />

        <com.hyphenate.easeui.widget.ChatUIKitArrowItemView
            android:id="@+id/item_website"
            app:arrowItemTitle="@string/main_about_me_visit_easemob"
            app:arrowItemContent="@string/main_about_me_visit_easemob_content"
            app:arrowItemShowAvatar="false"
            app:arrowItemShowArrow="false"
            style="@style/main_about_me_arrow_item"
            android:layout_width="match_parent"
            android:layout_height="54dp" />

        <com.hyphenate.easeui.widget.ChatUIKitArrowItemView
            android:id="@+id/item_sdk_version"
            app:arrowItemTitle="@string/main_about_me_sdk_version"
            app:arrowItemContent="Easemob SDK"
            app:arrowItemShowAvatar="false"
            app:arrowItemShowArrow="false"
            style="@style/main_about_me_arrow_item"
            android:layout_width="match_parent"
            android:layout_height="54dp" />

        <com.hyphenate.easeui.widget.ChatUIKitArrowItemView
            android:id="@+id/item_uikit_version"
            app:arrowItemTitle="@string/main_about_me_uikit_version"
            app:arrowItemContent="Easemob UIKit"
            app:arrowItemShowAvatar="false"
            app:arrowItemShowArrow="false"
            style="@style/main_about_me_arrow_item"
            android:layout_width="match_parent"
            android:layout_height="54dp" />

        <com.hyphenate.easeui.widget.ChatUIKitArrowItemView
            android:id="@+id/item_registration_number"
            app:arrowItemTitle="@string/main_about_me_registration_number"
            app:arrowItemContent="@string/main_about_me_registration_number_content"
            app:arrowItemShowAvatar="false"
            app:arrowItemShowArrow="false"
            style="@style/main_about_me_arrow_item"
            android:layout_width="match_parent"
            android:layout_height="54dp" />

        <com.hyphenate.easeui.widget.ChatUIKitArrowItemView
            android:id="@+id/item_policies"
            app:arrowItemTitle="@string/main_about_me_policies"
            app:arrowItemShowAvatar="false"
            style="@style/main_about_me_arrow_item"
            android:layout_width="match_parent"
            android:layout_height="54dp" />

        <TextView
            android:text="@string/main_about_me_setting"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:textAppearance="@style/Ease.TextAppearance.Label.Medium"
            android:textColor="@color/ease_details_subtitle2_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.hyphenate.easeui.widget.ChatUIKitArrowItemView
            android:id="@+id/item_presence"
            app:arrowItemTitle="@string/presence_status"
            app:arrowItemShowAvatar="false"
            style="@style/main_about_me_arrow_item"
            android:layout_width="match_parent"
            android:layout_height="54dp" />

        <com.hyphenate.easeui.widget.ChatUIKitArrowItemView
            android:id="@+id/item_information"
            app:arrowItemTitle="@string/main_about_me_information"
            app:arrowItemShowAvatar="false"
            style="@style/main_about_me_arrow_item"
            android:layout_width="match_parent"
            android:layout_height="54dp" />

        <com.hyphenate.easeui.widget.ChatUIKitArrowItemView
            android:id="@+id/item_currency"
            app:arrowItemTitle="@string/main_about_me_currency"
            app:arrowItemShowAvatar="false"
            style="@style/main_about_me_arrow_item"
            android:layout_width="match_parent"
            android:layout_height="54dp" />

        <com.hyphenate.easeui.widget.ChatUIKitArrowItemView
            android:id="@+id/item_notify"
            app:arrowItemTitle="@string/main_about_me_notify"
            app:arrowItemShowAvatar="false"
            style="@style/main_about_me_arrow_item"
            android:layout_width="match_parent"
            android:layout_height="54dp" />

        <com.hyphenate.easeui.widget.ChatUIKitArrowItemView
            android:id="@+id/item_privacy"
            app:arrowItemTitle="@string/main_about_me_block"
            app:arrowItemShowAvatar="false"
            style="@style/main_about_me_arrow_item"
            android:layout_width="match_parent"
            android:layout_height="54dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/about_me_logout"
            android:text="@string/main_about_me_logout"
            android:textSize="16sp"
            android:textColor="@color/ease_color_text_primary"
            android:background="@drawable/demo_me_logout_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="28dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/about_me_account_cancellation"
            android:text="@string/main_about_me_account_cancellation"
            android:textSize="16sp"
            android:textColor="@android:color/holo_red_light"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</ScrollView>
